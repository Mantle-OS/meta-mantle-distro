From 2fa3fb54bc2d28d3790068b788fb047d8c877970 Mon Sep 17 00:00:00 2001
From: JosephMillsAtWork <josephjamesmills@gmail.com>
Date: Tue, 7 Oct 2025 04:43:48 +0000
Subject: [PATCH] qt6 cast unit for the unicode

Signed-off-by: JosephMillsAtWork <josephjamesmills@gmail.com>
---
 scribus/util_text.cpp | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/scribus/util_text.cpp b/scribus/util_text.cpp
index 48194d3e7..73e5c048a 100644
--- a/scribus/util_text.cpp
+++ b/scribus/util_text.cpp
@@ -99,9 +99,10 @@ QString stringToUnicode(const QString &text)
 {
 	QString out;
 
-	for (auto c : text)
-		out += QString("U+%1,").arg(c.unicode(), 4, 16, QChar('0')).toUpper();
-
+	for (auto c : text){
+            const uint code = static_cast<uint>(c.unicode());
+            out += QString("U+%1,").arg(code, 4, 16, QChar(u'0')).toUpper();
+        }
 	return out.mid(0, out.length() -1);
 
 }
-- 
