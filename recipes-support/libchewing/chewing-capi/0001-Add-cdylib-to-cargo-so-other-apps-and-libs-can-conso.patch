Subject: [PATCH] Add cdylib to cargo so other apps and libs can consome

Upstream-Status: Pending
---
 capi/Cargo.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/capi/Cargo.toml b/capi/Cargo.toml
index e87d4164..0629efb1 100644
--- a/capi/Cargo.toml
+++ b/capi/Cargo.toml
@@ -7,7 +7,7 @@ rust-version = "1.88"
 edition = "2024"
 
 [lib]
-crate-type = ["rlib", "staticlib"]
+crate-type = ["cdylib", "rlib", "staticlib"]
 
 [dependencies]
 chewing = { version = "0.12.0", path = ".." }
