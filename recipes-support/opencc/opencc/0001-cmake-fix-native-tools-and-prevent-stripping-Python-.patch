From fb61e8346389517fef968b314ebd551e20a26535 Mon Sep 17 00:00:00 2001
From: jmills <josephjamesmills@gmail.com>
Date: Sun, 22 Nov 2026 18:08:52 -0600
Subject: [PATCH] cmake: fix native tools and prevent stripping Python bindings

Upstream-Status: Pending
---
 CMakeLists.txt      |  2 +-
 data/CMakeLists.txt | 23 +++++++++++++++++++++--
 2 files changed, 22 insertions(+), 3 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index ae5573ca..9067f463 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -432,6 +432,6 @@ if (BUILD_PYTHON)
     endif()
     add_subdirectory(deps/pybind11-2.13.1)
   endif()
-  pybind11_add_module(opencc_clib src/py_opencc.cpp)
+  pybind11_add_module(opencc_clib NO_EXTRAS src/py_opencc.cpp)
   target_link_libraries(opencc_clib PRIVATE libopencc)
 endif()
diff --git a/data/CMakeLists.txt b/data/CMakeLists.txt
index 5807ac10..ff3f2fe2 100644
--- a/data/CMakeLists.txt
+++ b/data/CMakeLists.txt
@@ -4,8 +4,27 @@ endif()
 
 find_package(Python3 REQUIRED COMPONENTS Interpreter)
 
-set(OPENCC_DICT_BIN opencc_dict)
-set(OPENCC_BIN opencc)
+if(CMAKE_CROSSCOMPILING)
+  if(NOT OPENCC_DICT_EXE)
+    message(FATAL_ERROR "Cross-compiling requires OPENCC_DICT_EXE to locate native tools.")
+  endif()
+  if(NOT OPENCC_EXE)
+    message(FATAL_ERROR "Cross-compiling requires OPENCC_EXE to locate native tools.")
+  endif()
+
+  add_executable(opencc_dict_native IMPORTED GLOBAL)
+  set_target_properties(opencc_dict_native PROPERTIES IMPORTED_LOCATION "${OPENCC_DICT_EXE}")
+
+  add_executable(opencc_native IMPORTED GLOBAL)
+  set_target_properties(opencc_native PROPERTIES IMPORTED_LOCATION "${OPENCC_EXE}")
+
+  set(OPENCC_DICT_BIN opencc_dict_native)
+  set(OPENCC_BIN opencc_native)
+else()
+  set(OPENCC_DICT_BIN opencc_dict)
+  set(OPENCC_BIN opencc)
+endif()
+
 set(DICT_REVERSE_BIN "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/scripts/reverse.py")
 set(DICT_EXTRACT_TOFU_RISK_BIN "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/scripts/extract_tofu_risk.py")
 set(DICT_GENERATE_ST_PHRASES_BIN "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/scripts/generate_st_phrases_from_regional_phrases.py")
-- 
2.55.0

