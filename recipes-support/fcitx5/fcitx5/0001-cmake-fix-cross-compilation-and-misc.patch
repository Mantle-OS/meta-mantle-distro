From a78651b939641db7f15d502f3ecbf9e0e3a9062a Mon Sep 17 00:00:00 2001
From: jmills <josephjamesmills@gmail.com>
Date: Sun, 22 Nov 2026 14:24:28 -0600
Subject: [PATCH] cmake: fix cross-compilation and installed CMake exports

Allow the spell dictionary generator to use a host-native executable during cross-compilation.

Make installed header include paths and exported module interfaces relocatable so downstream consumers can use Fcitx5 from a cross-compilation sysroot.

Correct the misspelled CMAKE_INSTALL_FULL_SYSCONFDIR variable.

Upstream-Status: Pending
---
 src/lib/fcitx-config/CMakeLists.txt           |  2 +-
 src/lib/fcitx-utils/CMakeLists.txt            |  2 +-
 src/lib/fcitx-utils/Fcitx5Macros.cmake        | 21 +++++++++++++++
 .../fcitx-utils/Fcitx5ModuleTemplate.cmake.in |  2 +-
 .../fcitx-utils/Fcitx5UtilsConfig.cmake.in    |  2 +-
 src/lib/fcitx/CMakeLists.txt                  |  2 +-
 src/modules/spell/CMakeLists.txt              | 27 ++++++++++++++++---
 7 files changed, 49 insertions(+), 9 deletions(-)

diff --git a/src/lib/fcitx-config/CMakeLists.txt b/src/lib/fcitx-config/CMakeLists.txt
index 60bfa14a..fcbe47fb 100644
--- a/src/lib/fcitx-config/CMakeLists.txt
+++ b/src/lib/fcitx-config/CMakeLists.txt
@@ -42,7 +42,7 @@ set_target_properties(Fcitx5Config
 target_include_directories(Fcitx5Config PUBLIC
     $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/..>
     $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}/..>
-    $<INSTALL_INTERFACE:${CMAKE_INSTALL_FULL_INCLUDEDIR}/Fcitx5/Config>)
+    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/Fcitx5/Config>)
 target_link_libraries(Fcitx5Config PUBLIC Fcitx5::Utils)
 
 configure_file(Fcitx5Config.pc.in ${CMAKE_CURRENT_BINARY_DIR}/Fcitx5Config.pc @ONLY)
diff --git a/src/lib/fcitx-utils/CMakeLists.txt b/src/lib/fcitx-utils/CMakeLists.txt
index 3ce54729..f61b0b0b 100644
--- a/src/lib/fcitx-utils/CMakeLists.txt
+++ b/src/lib/fcitx-utils/CMakeLists.txt
@@ -157,7 +157,7 @@ set_target_properties(Fcitx5Utils
 target_include_directories(Fcitx5Utils PUBLIC
     $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/..>
     $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}/..>
-    $<INSTALL_INTERFACE:${CMAKE_INSTALL_FULL_INCLUDEDIR}/Fcitx5/Utils>)
+    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/Fcitx5/Utils>)
 target_link_libraries(Fcitx5Utils PRIVATE LibIntl::LibIntl Pthread::Pthread)
 if(LIBKVM_FOUND)
     target_link_libraries(Fcitx5Utils PRIVATE LibKVM::LibKVM)
diff --git a/src/lib/fcitx-utils/Fcitx5Macros.cmake b/src/lib/fcitx-utils/Fcitx5Macros.cmake
index 3b1791f5..a9541904 100644
--- a/src/lib/fcitx-utils/Fcitx5Macros.cmake
+++ b/src/lib/fcitx-utils/Fcitx5Macros.cmake
@@ -101,6 +101,7 @@ endfunction()
 set(_Fcitx5ModuleMacros_SELF "${CMAKE_CURRENT_LIST_FILE}")
 get_filename_component(_Fcitx5ModuleMacros_SELF_DIR "${_Fcitx5ModuleMacros_SELF}" PATH)
 
+
 macro(fcitx5_export_module EXPORTNAME)
     set(options INSTALL)
     set(one_value_args BUILD_INCLUDE_DIRECTORIES TARGET INCLUDE_INSTALL_DIR LIB_INSTALL_DIR
@@ -108,21 +109,39 @@ macro(fcitx5_export_module EXPORTNAME)
     set(multi_value_args HEADERS)
     cmake_parse_arguments(FEM
         "${options}" "${one_value_args}" "${multi_value_args}" ${ARGN})
+
     if (FEM_INCLUDE_INSTALL_DIR)
         set(_MODULE_HEADER_DIR "${FEM_INCLUDE_INSTALL_DIR}")
     else()
         set(_MODULE_HEADER_DIR "${FCITX_INSTALL_MODULE_HEADER_DIR}/${FEM_TARGET}")
     endif()
+
     if (NOT FEM_LIB_INSTALL_DIR)
         set(FEM_LIB_INSTALL_DIR "${FCITX_INSTALL_LIBDIR}")
     endif()
+
     set(FEM_EXPORTNAME "${EXPORTNAME}")
     add_library(${FEM_TARGET}-interface INTERFACE)
     add_library(Fcitx5::Module::${EXPORTNAME} ALIAS ${FEM_TARGET}-interface)
     set_target_properties(${FEM_TARGET}-interface PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${FEM_BUILD_INCLUDE_DIRECTORIES}")
+
+    # Build-tree configuration.
+    set(FEM_INTERFACE_INCLUDE_DIR "${FEM_BUILD_INCLUDE_DIRECTORIES}")
     configure_file(
         "${_Fcitx5Macro_SELF_DIR}/Fcitx5ModuleTemplate.cmake.in"
         "${CMAKE_CURRENT_BINARY_DIR}/Fcitx5Module${EXPORTNAME}.cmake" @ONLY)
+
+    # Installed configuration with relocatable include paths.
+    get_filename_component(_MODULE_HEADER_ABS_DIR
+        "${_MODULE_HEADER_DIR}" ABSOLUTE BASE_DIR "${CMAKE_INSTALL_PREFIX}")
+    get_filename_component(_MODULE_CONFIG_ABS_DIR
+        "${FEM_LIB_INSTALL_DIR}/cmake/Fcitx5Module${EXPORTNAME}"
+        ABSOLUTE BASE_DIR "${CMAKE_INSTALL_PREFIX}")
+
+    file(RELATIVE_PATH _MODULE_HEADER_REL_DIR
+        "${_MODULE_CONFIG_ABS_DIR}" "${_MODULE_HEADER_ABS_DIR}")
+
+    set(FEM_INTERFACE_INCLUDE_DIR "\${CMAKE_CURRENT_LIST_DIR}/${_MODULE_HEADER_REL_DIR}")
     configure_file(
         "${_Fcitx5Macro_SELF_DIR}/Fcitx5ModuleTemplate.cmake.in"
         "${CMAKE_CURRENT_BINARY_DIR}/Fcitx5Module${EXPORTNAME}Config.cmake" @ONLY)
@@ -130,7 +149,9 @@ macro(fcitx5_export_module EXPORTNAME)
     if (NOT FEM_VERSION)
         set(FEM_VERSION ${PROJECT_VERSION})
     endif()
+
     write_basic_package_version_file("${CMAKE_CURRENT_BINARY_DIR}/Fcitx5Module${EXPORTNAME}ConfigVersion.cmake" VERSION "${FEM_VERSION}" COMPATIBILITY AnyNewerVersion)
+
     if(FEM_INSTALL)
         install(FILES "${CMAKE_CURRENT_BINARY_DIR}/Fcitx5Module${EXPORTNAME}Config.cmake"
                       "${CMAKE_CURRENT_BINARY_DIR}/Fcitx5Module${EXPORTNAME}ConfigVersion.cmake" DESTINATION "${FEM_LIB_INSTALL_DIR}/cmake/Fcitx5Module${EXPORTNAME}")
diff --git a/src/lib/fcitx-utils/Fcitx5ModuleTemplate.cmake.in b/src/lib/fcitx-utils/Fcitx5ModuleTemplate.cmake.in
index e51f044a..4cf71e38 100644
--- a/src/lib/fcitx-utils/Fcitx5ModuleTemplate.cmake.in
+++ b/src/lib/fcitx-utils/Fcitx5ModuleTemplate.cmake.in
@@ -4,4 +4,4 @@ endif()
 
 add_library(@FEM_TARGET@-interface INTERFACE)
 add_library(Fcitx5::Module::@FEM_EXPORTNAME@ ALIAS @FEM_TARGET@-interface)
-set_target_properties(@FEM_TARGET@-interface PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "@_MODULE_HEADER_DIR@")
+set_target_properties(@FEM_TARGET@-interface PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "@FEM_INTERFACE_INCLUDE_DIR@")
diff --git a/src/lib/fcitx-utils/Fcitx5UtilsConfig.cmake.in b/src/lib/fcitx-utils/Fcitx5UtilsConfig.cmake.in
index 9652f940..8415ec40 100644
--- a/src/lib/fcitx-utils/Fcitx5UtilsConfig.cmake.in
+++ b/src/lib/fcitx-utils/Fcitx5UtilsConfig.cmake.in
@@ -31,7 +31,7 @@ if (FCITX_INSTALL_USE_FCITX_SYS_PATHS)
 else()
     include(GNUInstallDirs)
     set(FCITX_INSTALL_PREFIX "${CMAKE_INSTALL_PREFIX}")
-    set(FCITX_INSTALL_SYSCONFDIR "${CAMKE_INSTALL_FULL_SYSCONFDIR}")
+    set(FCITX_INSTALL_SYSCONFDIR "${CMAKE_INSTALL_FULL_SYSCONFDIR}")
     set(FCITX_INSTALL_INCLUDEDIR "${CMAKE_INSTALL_FULL_INCLUDEDIR}")
     set(FCITX_INSTALL_LIBDIR "${CMAKE_INSTALL_FULL_LIBDIR}")
     set(FCITX_INSTALL_LIBDATADIR "${CMAKE_INSTALL_FULL_LIBDIR}")
diff --git a/src/lib/fcitx/CMakeLists.txt b/src/lib/fcitx/CMakeLists.txt
index 4f8938d5..986a2051 100644
--- a/src/lib/fcitx/CMakeLists.txt
+++ b/src/lib/fcitx/CMakeLists.txt
@@ -87,7 +87,7 @@ endif()
 target_include_directories(Fcitx5Core PUBLIC
     $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/..>
     $<BUILD_INTERFACE:${CMAKE_CURRENT_BINARY_DIR}/..>
-    $<INSTALL_INTERFACE:${CMAKE_INSTALL_FULL_INCLUDEDIR}/Fcitx5/Core>)
+    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/Fcitx5/Core>)
 target_link_libraries(Fcitx5Core PUBLIC Fcitx5::Config Fcitx5::Utils PRIVATE LibIntl::LibIntl)
 if (ENABLE_KEYBOARD)
     target_link_libraries(Fcitx5Core PRIVATE XKBCommon::XKBCommon)
diff --git a/src/modules/spell/CMakeLists.txt b/src/modules/spell/CMakeLists.txt
index acdbb2b1..a6a03716 100644
--- a/src/modules/spell/CMakeLists.txt
+++ b/src/modules/spell/CMakeLists.txt
@@ -40,11 +40,30 @@ fcitx5_download(spell-en-download ${SPELL_EN_DICT_URL} ${SPELL_EN_DICT_TAR}
 fcitx5_extract(spell-en-extract "${SPELL_EN_DICT_TAR}" DEPENDS spell-en-download
   OUTPUT ${SPELL_EN_DICT_SRC})
 
+if(CMAKE_CROSSCOMPILING)
+    set(FCITX5_COMP_SPELL_DICT_EXECUTABLE "" CACHE FILEPATH
+        "Path to the native comp-spell-dict executable")
+
+    if(NOT FCITX5_COMP_SPELL_DICT_EXECUTABLE OR
+       NOT EXISTS "${FCITX5_COMP_SPELL_DICT_EXECUTABLE}")
+        message(FATAL_ERROR
+            "Cross-compiling requires a native comp-spell-dict executable. "
+            "Set FCITX5_COMP_SPELL_DICT_EXECUTABLE to the path of the "
+            "host-native comp-spell-dict executable.")
+    endif()
+else()
+    set(FCITX5_COMP_SPELL_DICT_EXECUTABLE
+        "$<TARGET_FILE:comp-spell-dict>")
+endif()
+
 add_custom_command(
-  OUTPUT "${SPELL_EN_DICT}"
-  DEPENDS "${SPELL_EN_DICT_SRC}" Fcitx5::comp-spell-dict spell-en-extract
-  COMMAND Fcitx5::comp-spell-dict --comp-dict
-  "${SPELL_EN_DICT_SRC}" "${SPELL_EN_DICT}")
+    OUTPUT "${SPELL_EN_DICT}"
+    DEPENDS "${SPELL_EN_DICT_SRC}" spell-en-extract
+    COMMAND "${FCITX5_COMP_SPELL_DICT_EXECUTABLE}" --comp-dict
+            "${SPELL_EN_DICT_SRC}" "${SPELL_EN_DICT}"
+    VERBATIM
+)
+
 add_custom_target(spell_en_dict ALL DEPENDS "${SPELL_EN_DICT}")
 install(FILES "${SPELL_EN_DICT}" DESTINATION "${FCITX_INSTALL_PKGDATADIR}/spell")
 endif()
-- 
2.55.0

