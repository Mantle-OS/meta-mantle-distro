From 64dbc960eb842e64ad45a05c349e81dd398a4b16 Mon Sep 17 00:00:00 2001
From: jmills <josephjamesmills@gmail.com>
Date: Mon, 23 Nov 2026 22:56:38 -0600
Subject: [PATCH] Use Fcitx5Utils_DIR when cross compiling

Upstream-Status: Pending
---
 CMakeLists.txt | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6e94d43..8d68fe7 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -18,7 +18,11 @@ if (NOT DEFINED THAI_TARGET)
     set(THAI_TARGET PkgConfig::LibThai)
 endif()
 
-include("${FCITX_INSTALL_CMAKECONFIG_DIR}/Fcitx5Utils/Fcitx5CompilerSettings.cmake")
+if(CMAKE_CROSSCOMPILING)
+    include("${Fcitx5Utils_DIR}/Fcitx5CompilerSettings.cmake")
+else()
+    include("${FCITX_INSTALL_CMAKECONFIG_DIR}/Fcitx5Utils/Fcitx5CompilerSettings.cmake")
+endif()
 
 set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
 set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
