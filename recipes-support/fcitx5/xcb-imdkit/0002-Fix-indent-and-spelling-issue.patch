+option(USE_SYSTEM_UTHASH "Enable system uthash" ON)
 option(ENABLE_TEST "Enable unit tests for imdkit" ON)
 
 include(GenerateExportHeader)
@@ -14,7 +15,7 @@ include(ECMGenerateHeaders)
 include(uninstall)
 
