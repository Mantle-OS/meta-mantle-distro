From 285bc7937f78f99e7eaaed08c0ca7e50a52a072d Mon Sep 17 00:00:00 2001
From: jmills <josephjamesmills@gmail.com>
Date: Mon, 23 Nov 2026 21:39:13 -0600
Subject: [PATCH] Use Fcitx5Utils_DIR if cross compile

Upstream-Status: Pending
---
 CMakeLists.txt | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index bfe9cf9..1e26c8d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -30,7 +30,12 @@ set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
 set(CMAKE_LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
 set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
 
-include("${FCITX_INSTALL_CMAKECONFIG_DIR}/Fcitx5Utils/Fcitx5CompilerSettings.cmake")
+if(CMAKE_CROSSCOMPILING)
+    include("${Fcitx5Utils_DIR}/Fcitx5CompilerSettings.cmake")
+else()
+    include("${FCITX_INSTALL_CMAKECONFIG_DIR}/Fcitx5Utils/Fcitx5CompilerSettings.cmake")
+endif()
+
 add_definitions(-DFCITX_GETTEXT_DOMAIN=\"fcitx5-hangul\" -D_GNU_SOURCE)
 fcitx5_add_i18n_definition()
 
-- 
