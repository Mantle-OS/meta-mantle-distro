-function test_all(){
+test_all(){
 	TESTNAME="$1"
 	shift
 	>$TMPFILE
@@ -64,7 +64,7 @@ function test_all(){
 			dotest "$TESTNAME/$section" "$TMPFILE" "$SECHEAD" "$@"
