SUMMARY = "JUnit 6 Java testing framework"
DESCRIPTION = "JUnit 6 provides the Jupiter testing API and engine, the JUnit Platform launcher and console runner, and the Vintage engine for legacy JUnit tests."
HOMEPAGE = "https://junit.org/"
SECTION = "java"

LICENSE = "EPL-2.0"
LIC_FILES_CHKSUM = "file://${UNPACKDIR}/EPL-2.0;md5=REPLACE_WITH_VERIFIED_MD5"

JUNIT_MAVEN_URL = "https://repo1.maven.org/maven2/org/junit"

SRC_URI = " \
    ${JUNIT_MAVEN_URL}/jupiter/junit-jupiter-api/${PV}/junit-jupiter-api-${PV}.jar;name=jupiterapi;unpack=0 \
    ${JUNIT_MAVEN_URL}/jupiter/junit-jupiter-engine/${PV}/junit-jupiter-engine-${PV}.jar;name=jupiterengine;unpack=0 \
    ${JUNIT_MAVEN_URL}/platform/junit-platform-commons/${PV}/junit-platform-commons-${PV}.jar;name=commons;unpack=0 \
    ${JUNIT_MAVEN_URL}/platform/junit-platform-engine/${PV}/junit-platform-engine-${PV}.jar;name=engine;unpack=0 \
    ${JUNIT_MAVEN_URL}/platform/junit-platform-launcher/${PV}/junit-platform-launcher-${PV}.jar;name=launcher;unpack=0 \
    ${JUNIT_MAVEN_URL}/platform/junit-platform-console/${PV}/junit-platform-console-${PV}.jar;name=console;unpack=0 \
    ${JUNIT_MAVEN_URL}/platform/junit-platform-console-standalone/${PV}/junit-platform-console-standalone-${PV}.jar;name=standalone;unpack=0 \
    ${JUNIT_MAVEN_URL}/vintage/junit-vintage-engine/${PV}/junit-vintage-engine-${PV}.jar;name=vintage;unpack=0 \
    file://EPL-2.0 \
"
SRC_URI[jupiterapi.sha256sum] = "PLACEHOLDER"
SRC_URI[jupiterengine.sha256sum] = "PLACEHOLDER"
SRC_URI[commons.sha256sum] = "PLACEHOLDER"
SRC_URI[engine.sha256sum] = "PLACEHOLDER"
SRC_URI[launcher.sha256sum] = "PLACEHOLDER"
SRC_URI[console.sha256sum] = "PLACEHOLDER"
SRC_URI[standalone.sha256sum] = "PLACEHOLDER"
SRC_URI[vintage.sha256sum] = "PLACEHOLDER"

S = "${UNPACKDIR}"

PACKAGES =+ " \
    ${PN}-jupiter-api \
    ${PN}-jupiter-engine \
    ${PN}-platform-commons \
    ${PN}-platform-engine \
    ${PN}-platform-launcher \
    ${PN}-platform-console \
    ${PN}-platform-console-standalone \
    ${PN}-vintage-engine \
"

ALLOW_EMPTY:${PN} = "1"

JUNIT_MODULES = " \
    jupiter-api \
    jupiter-engine \
    platform-commons \
    platform-engine \
    platform-launcher \
    platform-console \
    platform-console-standalone \
    vintage-engine \
"

do_configure[noexec] = "1"
do_compile[noexec] = "1"

do_install() {
    install -d ${D}${datadir}/java

    for module in ${JUNIT_MODULES}; do
        case "$module" in
            jupiter-*) artifact="junit-${module}" ;;
            platform-*) artifact="junit-${module}" ;;
            vintage-*) artifact="junit-${module}" ;;
        esac

        install -m 0644 \
            ${UNPACKDIR}/${artifact}-${PV}.jar \
            ${D}${datadir}/java/${artifact}.jar
    done
}

FILES:${PN}-jupiter-api = "${datadir}/java/junit-jupiter-api.jar"
FILES:${PN}-jupiter-engine = "${datadir}/java/junit-jupiter-engine.jar"
FILES:${PN}-platform-commons = "${datadir}/java/junit-platform-commons.jar"
FILES:${PN}-platform-engine = "${datadir}/java/junit-platform-engine.jar"
FILES:${PN}-platform-launcher = "${datadir}/java/junit-platform-launcher.jar"
FILES:${PN}-platform-console = "${datadir}/java/junit-platform-console.jar"
FILES:${PN}-platform-console-standalone = "${datadir}/java/junit-platform-console-standalone.jar"
FILES:${PN}-vintage-engine = "${datadir}/java/junit-vintage-engine.jar"

RDEPENDS:${PN} = " \
    ${PN}-jupiter-api \
    ${PN}-jupiter-engine \
    ${PN}-platform-launcher \
    ${PN}-platform-console \
"

RDEPENDS:${PN}-jupiter-engine = " \
    ${PN}-jupiter-api \
    ${PN}-platform-engine \
"

RDEPENDS:${PN}-platform-engine = "${PN}-platform-commons"

RDEPENDS:${PN}-platform-launcher = " \
    ${PN}-platform-engine \
    ${PN}-platform-commons \
"

RDEPENDS:${PN}-platform-console = " \
    ${PN}-platform-launcher \
    ${PN}-platform-engine \
    ${PN}-platform-commons \
"

RDEPENDS:${PN}-vintage-engine = " \
    ${PN}-platform-engine \
"

BBCLASSEXTEND = "native"
